{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pxl-theme/pxl",
  "version": "0.6.0",
  "description": "An adjustable framework-ish static site theme with sensible defaults and nice looks.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pxl-theme/pxl.git"
  },
  "author": {
    "name": "Ege Esin",
    "email": "aegean@duck.com",
    "url": "https://ege.esin.net/en/about/"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/pxl-theme/pxl/issues"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://ege.esin.net/en/donate"
    },
    {
      "type": "patreon",
      "url": "https://patreon.com/egeesin"
    }
  ],
  "homepage": "https://github.com/pxl-theme/pxl#readme",
  "keywords": [
    "css",
    "html",
    "theme",
    "css-framework",
    "customizable",
    "11ty",
    "SSG"
  ],
  "browserslist": [
    ">= .5% and not dead and not op_mini all"
  ],
  "outputDirectory": "dist",
  "devCommand": "pnpm build",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm i",
  "framework": "eleventy",
  "scripts": {
    "start": "pnpm --sequential '/(^build:fast$|^watch$)/'",
    "clean": "pnpm '/^clean:.*/'",
    "clean:general": "pnpm exec rimraf --glob 'tmp/view/!(media)' 'tmp/static/*' 'dist/'",
    "clean:media": "pnpm exec rimraf tmp/view/media/",
    "prepareDistDir": "mkdir -p {tmp,dist}/static tmp/view dist/static/asset/font",
    "build": "pnpm --reporter-hide-prefix --no-bail --sequential '/(^clean:general$|^clean:media$|^prepareDistDir$|^process$|^lint$|^purge:style:unused$|^optimize$|^generateSearchIndex$)/'",
    "build:fast": "pnpm --sequential '/(^clean:general$|^prepareDistDir$|^process$|^lint$|^optimize$|^generateSearchIndex$)/'",
    "process": "pnpm --aggregate-output --parallel \"/^(^copy|^process|^compress):.*/\"",
    "copy:font": "pnpm exec cpy \"static/asset/font/**/*.woff2\" dist/static/asset/font/",
    "copy:gif": "pnpm exec cpy \"static/asset/**/*.gif\" dist/static/asset/",
    "DONTcopy:ss": "pnpm exec cpy \"static/screenshot.webp\" dist/ || true",
    "copy:json": "pnpm exec cpy \"static/script/**/*.json\" dist/static/script/",
		"DONTcopy:faviconSvg": "pnpm exec cpy \"static/favicon.svg\" dist/ || true",
		"DONTcopy:pesos": "node config/task/eleventy-import.js",
		"process:page:view": "pnpm exec eleventy --quiet --incremental --config=config/eleventy.js",
    "process:page:plain": "pnpm exec posthtml \"plain/**/*.html\" \"!plain/_include/**/*.html\" -o tmp/ -a -c config/posthtml.json",
    "process:style": "pnpm exec postcss \"static/style/index.css\" --config config/ --base static/style/ --dir tmp/static/style/",
    "compress:icon": "svg-sprite \"static/icon/**/*.svg\" --config config/svgsprite.json && pnpm exec svgo -i tmp/pi.svg -o dist/ --config config/svgo-sprite.js && node config/task/cheerio-sprite.js",
    "compress:favicon": "node config/task/sharp-favicon.js",
    "compress:img": "node config/task/sharp-compress.js",
    "compress:svg": "node config/task/svgo-compress.js",
    "lint": "pnpm '/^lint:.*/'",
    "lint:script": "pnpm exec biome check --write static/script/ --config-path=config/ --log-kind=compact",
    "lint:style": "pnpm exec stylelint \"tmp/static/style/**/*.css\" --config config/stylelint.json",
    "DONTlint:page:view": "pnpm exec html-validate \"tmp/view/**/*.html\" --config=config/html-validate.json",
    "DONTpurge:style:unused": "pnpm exec purgecss --css \"tmp/static/style/**/*.css\" --content \"tmp/view/**/*.html\" \"static/script/**/*.js\" -o tmp/static/style/ --config config/purgecss.js",
    "optimize": "pnpm --aggregate-output --parallel '/^optimize:.*/'",
    "DONTlint:page:plain": "pnpm exec html-validate \"tmp/plain/**/*.html\" --config=config/html-validate.json",
    "optimize:style": "node config/task/postcss-extract-mq.js && node config/task/postcss-optimize.js",
    "optimize:page:view": "pnpm exec posthtml \"**/*.html\" -o dist/ -a -r tmp/view -c config/posthtml-optimize.json >/dev/null && cpy \"tmp/view/**/*.{xml,xsl,txt,json,webmanifest}\" dist/ && cpy \"tmp/view/media/**/*\" dist/media/",
    "optimize:page:plain": "pnpm exec posthtml \"plain/**/*.{ht,x}ml\" -o dist/ -a -r tmp/ -c config/posthtml-optimize.json",
    "optimize:script:vendor": "node config/task/swc-vendor.js",
    "optimize:script": "pnpm exec swc static/script/ -d dist/ --config-file config/swc.json",
    "generateSearchIndex": "pnpm exec pagefind --silent --site dist/ --glob \"**/*.html\"",
    "watch": "pnpm --parallel '/(^watch:.*|^serve)/'",
    "serve": "pnpm exec eleventy --quiet --serve --incremental --dryrun --output=dist/ --config=config/eleventy.js",
    "gen:page:view": "pnpm --sequential '/(^process:page:view$|^lint:page:view$|^optimize:page:view$)/'",
    "gen:style": "pnpm --sequential '/(^process:style$|^lint:style$|^purge:style:unused$|^optimize:style$)/'",
    "gen:script": "pnpm --sequential '/(^lint:script$|^optimize:script:vendor$|^optimize:script$)/'",
    "watch:page:view": "pnpm exec chokidar \"view/**/*.{html,xml,liquid,md,json,js,jpg,jpeg,tif,png,webp,gif,webm,svg}\" \"config/{eleventy.js,posthtml-optimize.json}\" -c \"pnpm gen:page:view\"",
    "watch:page:plain": "pnpm exec chokidar --silent \"plain/**/*.html\" \"config/{html-validate,posthtml,posthtml-optimize}.json\" -c \"pnpm process:page:plain; pnpm lint:page:plain; pnpm optimize:page:plain\"",
    "watch:style": "pnpm exec chokidar \"static/style/**/*.css\" \"config/{postcss.config.js,purgecss.js,stylelint.json}\" \"config/task/{postcss-extract-mq,postcss-optimize}.js\" -c \"pnpm gen:style\"",
    "watch:script": "pnpm exec chokidar \"static/script/**/*.js\" \"config/{biome,swc}.json\" \"config/task/swc-vendor.js\" -c \"pnpm gen:script\"",
    "watch:img": "pnpm exec chokidar --silent \"static/asset/**/*.{jpeg,jpg,png,tif}\" \"config/task/sharp-{compress,vendor}.js\" -c \"pnpm compress:img\"",
    "watch:svg": "pnpm exec chokidar --silent \"static/asset/**/*.svg\" \"config/{svgo.js,task/svgo-compress.js}\" -c \"pnpm compress:svg\"",
    "watch:icon": "pnpm exec chokidar --silent \"static/icon/**/*.svg\" \"config/{svgo-sprite.js,svgsprite.js,task/cheerio-sprite.js}\" -c \"pnpm compress:icon\"",
    "watch:favicon": "pnpm exec chokidar --silent \"static/favicon.*\" \"config/task/sharp-favicon.js\" -c \"pnpm compress:favicon\"",
    "debug:11ty": "DEBUG=Eleventy* pnpm exec eleventy --dryrun --config=config/eleventy.js",
    "debug:11tyAll": "DEBUG=* pnpm exec eleventy --dryrun --config=config/eleventy.js",
    "debug:11tyBenchmark": "DEBUG=Eleventy:Benchmark* pnpm exec eleventy --dryrun --config=config/eleventy.js",
    "debug:11tyCache": "DEBUG=EleventyCacheAssets* pnpm exec eleventy --dryrun --config=config/eleventy.js",
    "upmod": "pnpm up -i -L && pnpm exec update-browserslist-db",
    "rsync": "rsync --archive --verbose --stats --compress --delete --rsh=ssh ./dist/ ege:/var/www/ege/dist/",
    "rsync-wsl": "wsl bash -c rsync --archive --verbose --stats --compress --delete --rsh=ssh ./dist/ ege:/var/www/ege/dist/"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-fetch": "^5.0.2",
    "@11ty/eleventy-img": "^6.0.1",
    "@11ty/eleventy-plugin-rss": "^2.0.3",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@11ty/import": "^1.0.14",
    "@biomejs/biome": "1.9.4",
    "@mightyplow/eleventy-plugin-cache-buster": "^1.1.3",
    "@sindresorhus/slugify": "^2.2.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.11.9",
    "@traptitech/markdown-it-spoiler": "^1.1.6",
    "@vrcd-community/markdown-it-video": "^1.1.1",
    "autoprefixer": "^10.4.21",
    "browserslist": "^4.24.4",
    "caniuse-lite": "^1.0.30001704",
    "cheerio": "1.0.0",
    "chokidar-cli": "^3.0.0",
    "cpy-cli": "^5.0.0",
    "cssnano": "^7.0.6",
    "dotenv": "^16.4.7",
    "eleventy-nbsp-filter": "^0.1.0",
    "eleventy-plugin-target-safe": "^0.6.0",
    "eleventy-plugin-time-to-read": "^1.3.0",
    "get-gravatar": "^5.0.0",
    "glob": "^11.0.1",
    "html-validate": "^9.5.0",
    "htmlnano": "^2.1.1",
    "lodash.unionby": "^4.8.0",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-collapsible": "^2.0.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-eleventy-img": "^0.10.2",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-implicit-figures": "^0.12.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-kbd": "^2.2.2",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-named-code-blocks": "^1.0.6",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^0.9.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-toc-done-right": "^4.2.0",
    "pagefind": "^1.3.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "postcss-custom-media": "^11.0.5",
    "postcss-extract-media-query": "^3.0.0",
    "postcss-font-variant": "^5.0.0",
    "postcss-import": "^16.1.0",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-lightningcss": "^1.0.1",
    "postcss-mixins": "^11.0.3",
    "postcss-nested": "^7.0.2",
    "postcss-obfuscator": "^1.6.1",
    "postcss-pseudo-class-any-link": "^10.0.1",
    "postcss-will-change": "^4.0.1",
    "posthtml": "^0.16.6",
    "posthtml-alt-always": "^1.0.1",
    "posthtml-classes": "^0.2.1",
    "posthtml-cli": "^0.10.0",
    "posthtml-include": "^2.0.1",
    "posthtml-lorem": "^1.0.0",
    "posthtml-md": "^1.1.0",
    "purgecss": "^7.0.2",
    "rimraf": "^6.0.1",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.33.5",
    "sharp-ico": "^0.1.5",
    "stylelint": "^16.15.0",
    "stylelint-config-recommended": "^15.0.0",
    "svg-sprite": "^2.0.4",
    "svgo": "^3.3.2",
    "terser": "^5.39.0",
    "truncate-html": "^1.2.0",
    "update-browserslist-db": "^1.1.3"
  },
  "dependencies": {
    "@github/relative-time-element": "^4.4.5",
    "@zachleat/snow-fall": "^1.0.3",
    "@zachleat/webcare-webshare": "^1.0.3",
    "colcade": "^0.2.0",
    "lite-youtube-embed": "^0.3.3",
    "sanitize.css": "^13.0.0"
  },
  "overrides": {
    "marked@>=0.3.14 <0.6.2": ">=0.6.2",
    "got@<11.8.5": ">=11.8.5",
    "marked@<4.0.10": ">=4.0.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@swc/core",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
