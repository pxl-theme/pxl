{%- comment %}
<script>
(function() {
	function isDateInChristmas(){
		const now = new Date();
		const month = now.getMonth(); // 0 = January, 11 = December
		const day = now.getDate();
		if (month === 11 && day >= 25 && day <= 31){ return true; }
		if (month === 0 && day >= 1 && day <= 7) { return true; }
		return false
	}
	// Check if the current date is within the range
	if (isDateInChristmas()) {
		import("{{ "/static/script/_vendor/snow-fall.js" | url }}")
			.then(module => {
				module.default;
			})
			.catch(err => {
				console.error('Error loading the module:', err);
			});
	}
})();
</script>
