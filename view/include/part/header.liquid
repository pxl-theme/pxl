<header
	aria-label=Main
	class="
	c-header
	t-modRoot -cornerInherit -borderValNone -stylesetAcetate
	{% if options.forceDarkHeader == true %}t-color -forceDark -schemeInherit{% endif %}
	"
	style="background-color: var(--colorBack);"
	>
	<div class=o-rustygrid>
	{%- if modifications.compactHeader == false or baseLite == true -%}
		<div class="-col1 {% if description %}-col5-12@palm{% else %}-col5-6{% endif %} -push1-12@palm o-rustygrid__item" style="user-select:none">
			{% comment %} <h1 style="font-family:'Iosevka Aegean Mono',var(--fontHeading);--letterSpacing:-.0625em"> {% endcomment %}
			<h1 style="font-family:var(--fontHeading);--letterSpacing:-.0625em">
				<a href={{ "/" | locale_url }} title="{{ translation[lang].homeDescription }}"
					{%- if site.favicon.webp192 -%}
						><img class="_faviconAnimated" eleventy:ignore style="margin-inline-start:.5ch" src="{{ site.favicon.webp192 }}" width=48px alt=""
					{%- else -%}
						><svg class="pi -size2x" style="--iconWeight: 2px" viewBox='0 0 18 18' width="2rem"><use href='/pi.svg#house'></use></svg
					{%- endif -%}
				{%- if type == "homepage" -%}
					><span style="margin-inline-start:.5ch;">{{ site.title }}</span
				></a>
				{%- else -%}
				><span style="margin-inline-start:.5ch;">{{ site.pwa.titleShort | default: site.title }}</span
				></a><span style=--fontWeight:100>{{- options.titleSeparator | default: site.options.titleSeparator	-}}</span
					><a href="{{ page.url }}">{% if customHeaderTitle %}{{ customHeaderTitle }}{% else %}{{ title }}{% endif %}</a>
				{%- endif -%}
			</h1>
		</div>
		{%- if description and baseLite == nil -%}
			<div class="o-rustygrid__item -col1 -col5-12@palm -push1-12@palm" style=user-select:none>
				<i id=js-randomDesc class=u-txtAlignEnd@palm style="--fontWeight:300;display:block;text-wrap:balance">{{ description }}</i>
				{%- comment %} <h4 id=js-randomDesc class=u-txtOnImg style=text-align:end>{{ description }}</h4> {% endcomment -%}
			</div>
		{%- endif -%}
	{%- endif -%}
	</div>
	{%- unless baseLite == true %}
		{%- include "part/nav-wrapper"
			navClass: "-typeTree -flowHorizontal -expandFromBlockStart -alignStart",
			navResponsive: true,
			toggleNavID: "toggleNav-000"
		 -%}
	{%- endunless -%}
</header>
